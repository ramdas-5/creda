DATABASE_URL=sqlite:///./bank.db
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/bankdb
JWT_SECRET=dev-access-secret-change-me-min-32-chars-long!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars-long!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
