# Copy to .env and fill in real values. Never commit .env.
# Backend (FastAPI)
DATABASE_URL=postgresql+psycopg2://banking:banking_dev_password@localhost:5432/banking
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# Frontend (Vite — must start with VITE_ to be exposed to the browser)
VITE_API_URL=http://localhost:8000

# Local compose defaults (optional overrides)
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking_dev_password
POSTGRES_DB=banking
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
